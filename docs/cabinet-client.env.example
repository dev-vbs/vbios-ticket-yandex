# Public client settings only. Connect as client.env_file; see cabinet-full-config.md.
# Existing compose environment entries take priority over this file.
APP_NAME=vBios
APP_DESCRIPTION=Услуги, оплата и поддержка в одном кабинете
LOGO_URL=
DEFAULT_LANGUAGE=ru
SINGLE_LANGUAGE=ru
CUSTOM_LANGS=
SHM_BASE_PATH=/

# Authentication
